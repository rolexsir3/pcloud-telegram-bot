# From https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=your_api_hash

# From @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Comma separated Telegram user IDs allowed to use the bot
# (message the bot once and it will reply with your ID)
ALLOWED_USER_IDS=111111111

# Name of the rclone remote you created with `rclone config` (type: filen)
RCLONE_REMOTE=filen

# Top-level folder in Filen where all your folders are created
STORAGE_ROOT=Telegram

# Optional
# RCLONE_BIN=/usr/bin/rclone
# TMP_DIR=/tmp
# STATE_FILE=state.json
