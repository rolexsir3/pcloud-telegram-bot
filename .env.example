# From https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=your_api_hash

# From @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Comma separated Telegram user IDs allowed to use the bot
# (message the bot once and it will reply with your ID)
ALLOWED_USER_IDS=111111111

# pCloud account
PCLOUD_USERNAME=you@example.com
PCLOUD_PASSWORD=your_password
# US accounts: api.pcloud.com   EU accounts: eapi.pcloud.com
PCLOUD_HOST=api.pcloud.com
# Top-level folder in pCloud where all your folders are created
PCLOUD_ROOT=Telegram

# Optional
# TMP_DIR=/tmp
# STATE_FILE=state.json
